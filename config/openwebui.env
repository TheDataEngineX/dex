# ============================================================
#  Open WebUI - Personal Assistant configuration
#  Loaded by scripts/dex.py on start (KEY=VALUE, no spaces)
# ============================================================

# ---- Core server ----
OLLAMA_BASE_URL=http://localhost:11434
WEBUI_URL=http://localhost:8080
# WEBUI_SECRET_KEY is generated automatically and stored in .webui_secret_key
# (gitignored) on first start - do not commit a real key here.
# DATA_DIR is auto-computed by scripts/dex.py (the project's data/ folder).
ENABLE_PERSISTENT_CONFIG=true

# ---- Accounts ----
ENABLE_SIGNUP=true
ENABLE_LOGIN_FORM=true
ENABLE_API_KEYS=true

# ---- Tools & MCP (browser automation) ----
ENABLE_TOOL_SERVERS=true
# ASSISTANT_FILES_DIR is auto-computed by scripts/dex.py (the project's assistant-files/ folder).

# ---- Built-in web search (free, no API key required) ----
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=2

# ---- Scheduled tasks / automations ----
SCHEDULER_POLL_INTERVAL=10

# ---- Housekeeping ----
ANONYMIZED_TELEMETRY=false
GLOBAL_LOG_LEVEL=INFO
